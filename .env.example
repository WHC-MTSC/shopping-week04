# Documentation only: the application does not automatically load a .env file.
# Set these in the shell/service environment before starting uvicorn.
# Never add AWS secret access keys or cached credentials to this file.
AWS_REGION=ap-northeast-2
AWS_PROFILE=workload
WORKLOAD_LOG_DB=runtime/events.sqlite3
WORKLOAD_S3_PREFIX=workload-events
# local-s3 writes simulated objects locally without using AWS credentials.
# Allowed: local (SQLite), local-s3 (local objects), s3, cloudwatch (real AWS).
WORKLOAD_LOG_BACKEND=local-s3
WORKLOAD_LOCAL_S3_ROOT=runtime/local-s3
# For real AWS only: select backend s3 and set the CloudFormation BucketName output.
WORKLOAD_S3_BUCKET=
# For CloudWatch: existing group/stream, with PutLogEvents permission.
WORKLOAD_CLOUDWATCH_LOG_GROUP=
WORKLOAD_CLOUDWATCH_LOG_STREAM=
# Optional JSON model; read once when starting the server.
WORKLOAD_MODEL_PATH=artifacts/model.json
