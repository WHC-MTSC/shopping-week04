{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWorkloadEvents",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": { "StringLike": { "s3:prefix": ["workload-events", "workload-events/*"] } }
    },
    {
      "Sid": "ReadWorkloadEvents",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/workload-events/*"
    }
  ]
}
